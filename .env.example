# Copy this file to .env and fill in real values.
# The backend builds its MongoDB connection string as:
#   DB_HOST_PREFIX + DB_USER + ":" + DB_PASS + "@" + DB_HOST_SUFFIX

# The defaults below work out of the box with the MongoDB container in
# docker-compose.yml. If you run the backend outside docker, use
# DB_HOST_SUFFIX=localhost:27017 instead.
#
# For a MongoDB Atlas cluster use:
#   DB_HOST_PREFIX=mongodb+srv://
#   DB_HOST_SUFFIX=yourcluster.example.mongodb.net/?retryWrites=true&w=majority
DB_HOST_PREFIX=mongodb://
DB_USER=briscola
DB_PASS=briscola
DB_HOST_SUFFIX=mongo:27017

# Database and collection names
DB_GAMES_DATABASE_NAME=briscola
DB_GAMES_COLLECTION_NAME=games
DB_GAMES_AS_STRINGS_COLLECTION_NAME=gamesAsStrings

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
